<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.AI悬浮窗" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_200</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <!-- 现代风格主题 - 深色模式 -->
    <style name="Theme.ModernSettings" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#90CAF9</item>
        <item name="colorPrimaryVariant">#42A5F5</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">#90CAF9</item>
        <item name="colorSecondaryVariant">#90CAF9</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">#121212</item>
        <item name="android:windowBackground">#121212</item>
        <item name="android:navigationBarColor">#121212</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <!-- 自定义深色模式适配属性 -->
        <item name="bgPage">#121212</item>
        <item name="bgCard">#1E1E1E</item>
        <item name="textPrimary">#E0E0E0</item>
        <item name="textSecondary">#9E9E9E</item>
        <item name="textHint">#757575</item>
        <item name="dividerColor">#333333</item>
        <item name="dividerLight">#2A2A2A</item>
        <item name="colorPrimaryBrand">#90CAF9</item>
        <item name="btnSecondaryBg">#1A2733</item>
        <item name="btnSecondaryText">#90CAF9</item>
        <item name="trackColor">#555555</item>
        <item name="inputBg">#2C2C2C</item>
        <item name="inputStroke">#444444</item>
    </style>
</resources>