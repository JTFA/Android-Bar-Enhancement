            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/seek_border_width"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="20"
            android:progress="2"
            android:layout_marginBottom="16dp" />

        <!-- 窗口圆角半径 -->
        <TextView
            android:id="@+id/text_corner_radius"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="窗口圆角: 16dp"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/seek_corner_radius"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:min="0"
            android:max="50"
            android:progress="16"
            android:layout_marginBottom="24dp" />

        <!-- 边框颜色 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="边框颜色 (RGB)"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edit_border_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="格式：#RRGGBB，默认 #4CAF50"
            android:inputType="text"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:textSize="14sp"
            android:text="#4CAF50"
            android:layout_marginBottom="16dp" />

        <!-- 边框透明度 -->
        <TextView
            android:id="@+id/text_border_alpha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="边框透明度: 1.00"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/seek_border_alpha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="100"
            android:layout_marginBottom="24dp" />

