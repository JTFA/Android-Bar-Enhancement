<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="提示条设置"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="32dp" />

        <!-- ===== 提示条触发行为设置 ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bar_trigger_actions"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bar_trigger_actions_desc"
            android:textSize="12sp"
            android:textColor="#999999"
            android:layout_marginBottom="16dp" />

        <!-- 单击行为选择 -->
        <LinearLayout
            android:id="@+id/layout_click_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/click_action"
                android:textSize="14sp"
                android:textColor="#666666" />

            <TextView
                android:id="@+id/text_click_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_none"
                android:textSize="14sp"
                android:textColor="#333333"
                android:gravity="end" />

        </LinearLayout>

        <!-- 单击应用选择（仅当单击行为为"打开指定应用"时可见） -->
        <LinearLayout
            android:id="@+id/layout_click_app"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/select_app"
                android:textSize="14sp"
                android:textColor="#666666" />

            <TextView
                android:id="@+id/text_click_selected_app"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/not_selected"
                android:textSize="14sp"
                android:textColor="#333333"
                android:gravity="end" />

        </LinearLayout>

        <!-- 双击行为选择 -->
        <LinearLayout
            android:id="@+id/layout_double_click_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/double_click_action"
                android:textSize="14sp"
                android:textColor="#666666" />

            <TextView
                android:id="@+id/text_double_click_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_open_shortcut"
                android:textSize="14sp"
                android:textColor="#333333"
                android:gravity="end" />

        </LinearLayout>

        <!-- 双击应用选择（仅当双击行为为"打开指定应用"时可见） -->
        <LinearLayout
            android:id="@+id/layout_double_click_app"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/select_app"
                android:textSize="14sp"
                android:textColor="#666666" />

            <TextView
                android:id="@+id/text_double_click_selected_app"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/not_selected"
                android:textSize="14sp"
                android:textColor="#333333"
                android:gravity="end" />

        </LinearLayout>

        <!-- 长按行为选择 -->
        <LinearLayout
            android:id="@+id/layout_long_press_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/long_press_action"
                android:textSize="14sp"
                android:textColor="#666666" />

            <TextView
                android:id="@+id/text_long_press_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_open_ai"
                android:textSize="14sp"
                android:textColor="#333333"
                android:gravity="end" />

        </LinearLayout>

        <!-- 长按应用选择（仅当长按行为为"打开指定应用"时可见） -->
        <LinearLayout
            android:id="@+id/layout_long_press_app"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/select_app"
                android:textSize="14sp"
                android:textColor="#666666" />

            <TextView
                android:id="@+id/text_long_press_selected_app"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/not_selected"
                android:textSize="14sp"
                android:textColor="#333333"
                android:gravity="end" />

        </LinearLayout>

        <!-- 分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginBottom="24dp" />



        <!-- 提示条样式设置 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="提示条触发区域"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="见黑色区域，为防止烧屏，退出设置页面后将隐藏"
            android:textSize="12sp"
            android:textColor="#999999"
            android:layout_marginBottom="16dp" />

        <!-- 提示条宽度 -->
        <TextView
            android:id="@+id/text_bar_width"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="宽度: 300dp"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/seek_bar_width"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:min="200"
            android:max="600"
            android:progress="300"
            android:layout_marginBottom="16dp" />

        <!-- 提示条高度 -->
        <TextView
            android:id="@+id/text_bar_height"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="高度: 60dp"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/seek_bar_height"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="150"
            android:progress="60"
            android:layout_marginBottom="16dp" />

        <!-- 提示条位置 Y -->
        <TextView
            android:id="@+id/text_bar_position_y"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="位置 Y: 20dp (距底部)"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/seek_bar_position_y"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:min="-500"
            android:max="500"
            android:progress="20"
            android:layout_marginBottom="16dp" />

        <!-- 提示条圆角 -->
        <TextView
            android:id="@+id/text_bar_corner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="圆角: 30dp"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/seek_bar_corner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="60"
            android:progress="30"
            android:layout_marginBottom="16dp" />


        <!-- 长按触发时间 -->
        <TextView
            android:id="@+id/text_long_press_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="长按触发时间: 500ms"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/seek_long_press_duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:min="50"
            android:max="2000"
            android:progress="500"
            android:layout_marginBottom="16dp" />

        <!-- ===== 按下提示条样式设置 ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="提示条按下样式"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="手指按住提示条时的样式变化，调节时可实时显示"
            android:textSize="12sp"
            android:textColor="#999999"
            android:layout_marginBottom="16dp" />

        <!-- 按下时启用开关 -->
        <Switch
            android:id="@+id/switch_pressed_bar_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="启用按下样式变化"
            android:textSize="14sp"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <!-- 按下时宽度 -->
        <TextView
            android:id="@+id/text_pressed_bar_width"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="按下时宽度: 320dp"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/seek_pressed_bar_width"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="600"
            android:min="200"
            android:progress="320"
            android:layout_marginBottom="16dp" />

        <!-- 按下时高度 -->
        <TextView
            android:id="@+id/text_pressed_bar_height"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="按下时高度: 65dp"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/seek_pressed_bar_height"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="150"
            android:progress="65"
            android:layout_marginBottom="16dp" />

        <!-- 按下时位置Y -->
        <TextView
            android:id="@+id/text_pressed_bar_position_y"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="按下时位置Y: 20dp"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/seek_pressed_bar_position_y"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:min="-500"
            android:max="500"
            android:progress="20"
            android:layout_marginBottom="24dp" />

        <!-- 按下时圆角 -->
        <TextView
            android:id="@+id/text_pressed_bar_corner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="按下时圆角: 35dp"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/seek_pressed_bar_corner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="60"
            android:progress="35"
            android:layout_marginBottom="16dp" />

        <!-- 按下时透明度 -->
        <TextView
            android:id="@+id/text_pressed_bar_alpha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="按下时透明度: 0.60"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/seek_pressed_bar_alpha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="60"
            android:layout_marginBottom="16dp" />

        <!-- 按下时颜色 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="按下时颜色 (RGB)"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edit_pressed_bar_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="格式：#RRGGBB，默认 #333333"
            android:inputType="text"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:textSize="14sp"
            android:text="#333333"
            android:layout_marginBottom="16dp" />

        <!-- 边缘羽化宽度 -->
        <TextView
            android:id="@+id/text_pressed_bar_feather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="边缘羽化宽度: 15dp"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/seek_pressed_bar_feather"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:min="0"
            android:max="50"
            android:progress="15"
            android:layout_marginBottom="16dp" />



        <!-- 分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="窗口设置"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="32dp" />


        <!-- AI 对话窗口设置 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI窗口设置"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="16dp" />

        <!-- AI 网页 URL 设置 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI 窗口网页 URL"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edit_ai_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="输入 AI 网页地址（如：https://www.doubao.com）"
            android:inputType="textUri"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <!-- AI 窗口宽度 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="宽度 (dp)"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edit_window_width"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="范围：200-600dp，默认 350dp"
            android:inputType="number"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <!-- AI 窗口高度 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="高度 (dp)"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edit_window_height"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="范围：300-900dp，默认 600dp"
            android:inputType="number"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <!-- AI 窗口位置 Y -->
        <TextView
            android:id="@+id/text_window_position_y"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="窗口位置 Y: 0 (居中)"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/seek_window_position_y"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:min="-500"
            android:max="500"
            android:progress="0"
            android:layout_marginBottom="24dp" />

        <!-- 窗口圆角半径 -->
        <TextView
            android:id="@+id/text_corner_radius"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="窗口圆角: 16dp"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/seek_corner_radius"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:min="0"
            android:max="50"
            android:progress="16"
            android:layout_marginBottom="24dp" />


        <!-- 边框宽度 -->
        <TextView
            android:id="@+id/text_border_width"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="边框宽度: 2dp"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/seek_border_width"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="20"
            android:progress="2"
            android:layout_marginBottom="16dp" />

        <!-- 边框颜色 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="边框颜色 (RGB)"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edit_border_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="格式：#RRGGBB，默认 #4CAF50"
            android:inputType="text"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:textSize="14sp"
            android:text="#4CAF50"
            android:layout_marginBottom="16dp" />

        <!-- 边框透明度 -->
        <TextView
            android:id="@+id/text_border_alpha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="边框透明度: 1.00"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/seek_border_alpha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="100"
            android:layout_marginBottom="24dp" />


        <!-- 右上角按钮组显示设置 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="右上角按钮组"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="显示/隐藏窗口右上角的返回、刷新、关闭按钮"
            android:textSize="12sp"
            android:textColor="#999999"
            android:layout_marginBottom="12dp" />

        <!-- 显示关闭按钮 -->
        <Switch
            android:id="@+id/switch_show_close_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="显示关闭按钮（默认开启）"
            android:textSize="14sp"
            android:padding="12dp"
            android:layout_marginBottom="4dp" />

        <!-- 显示刷新按钮 -->
        <Switch
            android:id="@+id/switch_show_refresh_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="显示刷新按钮（默认开启）"
            android:textSize="14sp"
            android:padding="12dp"
            android:layout_marginBottom="4dp" />

        <!-- 显示后退按钮 -->
        <Switch
            android:id="@+id/switch_show_back_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="显示后退按钮（默认开启）"
            android:textSize="14sp"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- 点击窗口外关闭窗口 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
