        <!-- 右上角按钮组显示设置 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="右上角按钮组"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="显示/隐藏窗口右上角的返回、刷新、关闭按钮"
            android:textSize="12sp"
            android:textColor="#999999"
            android:layout_marginBottom="12dp" />

        <!-- 显示关闭按钮 -->
        <Switch
            android:id="@+id/switch_show_close_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="显示关闭按钮（默认开启）"
            android:textSize="14sp"
            android:padding="12dp"
            android:layout_marginBottom="4dp" />

        <!-- 显示刷新按钮 -->
        <Switch
            android:id="@+id/switch_show_refresh_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="显示刷新按钮（默认开启）"
            android:textSize="14sp"
            android:padding="12dp"
            android:layout_marginBottom="4dp" />

        <!-- 显示后退按钮 -->
        <Switch
            android:id="@+id/switch_show_back_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="显示后退按钮（默认开启）"
            android:textSize="14sp"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- 点击窗口外关闭窗口 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="点击窗口外关闭窗口"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <Switch
            android:id="@+id/switch_close_on_outside_click"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="点击窗口外部区域时关闭窗口（默认开启）"
            android:textSize="14sp"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- 侧边返回手势行为 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="侧边返回手势"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <Switch
            android:id="@+id/switch_back_prioritize_webview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="优先返回网页上一级（关闭时始终关闭窗口）"
            android:textSize="14sp"
            android:padding="12dp"
            android:layout_marginBottom="24dp" />

        <!-- 分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginBottom="24dp" />

        <!-- ===== 单击提示条操作设置 ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/click_bar_action"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/click_bar_action_desc"
            android:textSize="12sp"
            android:textColor="#999999"
            android:layout_marginBottom="16dp" />

        <!-- 已选应用显示区域（可点击） -->
        <LinearLayout
            android:id="@+id/layout_select_app"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/select_app"
                android:textSize="14sp"
                android:textColor="#666666" />

            <TextView
                android:id="@+id/text_selected_app"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/not_selected"
                android:textSize="14sp"
                android:textColor="#333333"
                android:gravity="end" />

        </LinearLayout>

        <!-- 分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginBottom="24dp" />

        <!-- 输入法避让设置 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="输入法避让设置"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="当网页调起输入法时，窗口自动上移避免遮挡"
            android:textSize="12sp"
            android:textColor="#999999"
            android:layout_marginBottom="16dp" />

        <!-- 输入法弹出时窗口上移距离 -->
        <TextView
            android:id="@+id/text_keyboard_offset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="窗口上移距离: 300px"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

