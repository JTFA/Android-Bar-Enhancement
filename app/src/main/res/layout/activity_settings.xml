<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI 悬浮窗设置"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="32dp" />

        <!-- AI 网页 URL 设置 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI 对话网页 URL"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edit_ai_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="输入 AI 网页地址（如：https://chat.example.com）"
            android:inputType="textUri"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <!-- 分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginBottom="24dp" />

        <!-- 提示条样式设置 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="触发区域"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="16dp" />

        <!-- 提示条宽度 -->
        <TextView
            android:id="@+id/text_bar_width"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="宽度: 300dp"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/seek_bar_width"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:min="200"
            android:max="600"
            android:progress="300"
            android:layout_marginBottom="16dp" />

        <!-- 提示条高度 -->
        <TextView
            android:id="@+id/text_bar_height"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="高度: 60dp"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/seek_bar_height"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="150"
            android:progress="60"
            android:layout_marginBottom="16dp" />

        <!-- 提示条圆角 -->
        <TextView
            android:id="@+id/text_bar_corner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="圆角: 30dp"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/seek_bar_corner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="60"
            android:progress="30"
            android:layout_marginBottom="16dp" />

        <!-- 提示条位置 Y -->
        <TextView
            android:id="@+id/text_bar_position_y"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="位置 Y: 20dp (距底部)"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/seek_bar_position_y"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:min="-500"
            android:max="500"
            android:progress="20"
            android:layout_marginBottom="16dp" />

        <!-- 长按触发时间 -->
        <TextView
            android:id="@+id/text_long_press_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="长按触发时间: 500ms"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/seek_long_press_duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:min="50"
            android:max="2000"
            android:progress="500"
            android:layout_marginBottom="16dp" />

        <!-- ===== 按下提示条样式设置 ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="按下提示条样式"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="手指按住提示条（未触发长按）时的样式变化"
            android:textSize="12sp"
            android:textColor="#999999"
            android:layout_marginBottom="16dp" />

        <!-- 按下时启用开关 -->
        <Switch
            android:id="@+id/switch_pressed_bar_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="启用按下样式变化（默认开启）"
            android:textSize="14sp"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <!-- 按下时宽度 -->
        <TextView
            android:id="@+id/text_pressed_bar_width"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="按下时宽度: 320dp"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/seek_pressed_bar_width"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="600"
            android:min="200"
            android:progress="320"
            android:layout_marginBottom="16dp" />

        <!-- 按下时高度 -->
        <TextView
            android:id="@+id/text_pressed_bar_height"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="按下时高度: 65dp"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/seek_pressed_bar_height"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="150"
            android:progress="65"
            android:layout_marginBottom="16dp" />

        <!-- 按下时圆角 -->
        <TextView
            android:id="@+id/text_pressed_bar_corner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="按下时圆角: 35dp"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/seek_pressed_bar_corner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="60"
            android:progress="35"
            android:layout_marginBottom="16dp" />

        <!-- 按下时透明度 -->
        <TextView
            android:id="@+id/text_pressed_bar_alpha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="按下时透明度: 0.60"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/seek_pressed_bar_alpha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="60"
            android:layout_marginBottom="16dp" />

        <!-- 按下时颜色 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="按下时颜色 (RGB)"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edit_pressed_bar_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="格式：#RRGGBB，默认 #333333"
            android:inputType="text"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:textSize="14sp"
            android:text="#333333"
            android:layout_marginBottom="16dp" />

        <!-- 边缘羽化宽度 -->
        <TextView
            android:id="@+id/text_pressed_bar_feather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="边缘羽化宽度: 15dp"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/seek_pressed_bar_feather"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:min="0"
            android:max="50"
            android:progress="15"
            android:layout_marginBottom="16dp" />

        <!-- 按下时位置Y -->
        <TextView
            android:id="@+id/text_pressed_bar_position_y"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="按下时位置Y: 20dp"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/seek_pressed_bar_position_y"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:min="-500"
            android:max="500"
            android:progress="20"
            android:layout_marginBottom="24dp" />

        <!-- 分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginBottom="24dp" />

        <!-- AI 对话窗口设置 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI 对话窗口大小"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="16dp" />

        <!-- AI 窗口宽度 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="宽度 (dp)"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edit_window_width"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="范围：200-600dp，默认 350dp"
            android:inputType="number"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <!-- AI 窗口高度 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="高度 (dp)"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edit_window_height"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="范围：300-900dp，默认 600dp"
            android:inputType="number"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <!-- AI 窗口位置 Y -->
        <TextView
            android:id="@+id/text_window_position_y"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="窗口位置 Y: 0 (居中)"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/seek_window_position_y"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:min="-500"
            android:max="500"
            android:progress="0"
            android:layout_marginBottom="24dp" />

