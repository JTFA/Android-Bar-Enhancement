<?xml version="1.0" encoding="utf-8"?>
        <!-- ===== 提示条触发行为设置卡片 ===== -->
        <LinearLayout
            xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="交互与样式设置"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/textPrimary"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bar_trigger_actions_desc"
                android:textSize="12sp"
                android:textColor="?attr/textHint"
                android:layout_marginBottom="16dp" />

            <!-- 单击行为选择 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/click_action"
                android:textSize="15sp"
                android:textColor="?attr/textPrimary"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/spinner_click_action"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:entries="@array/action_entries"
                android:background="@drawable/spinner_background"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="8dp" />

            <!-- 单击触发时振动（行为为"无"时隐藏） -->
            <LinearLayout
                android:id="@+id/layout_click_vibrate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="8dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="触发时振动"
                    android:textSize="14sp"
                    android:textColor="?attr/textPrimary" />

                <Switch
                    android:id="@+id/switch_click_vibrate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="?attr/colorPrimaryBrand"
                    android:trackTint="#BDBDBD" />

            </LinearLayout>

<!--            <View-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="1dp"-->
<!--                android:background="?attr/dividerLight" />-->

            <!-- 单击应用选择（仅当单击行为为"打开指定应用"时可见） -->
            <LinearLayout
                android:id="@+id/layout_click_app"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="14dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/select_app"
                    android:textSize="15sp"
                    android:textColor="?attr/textPrimary" />

                <TextView
                    android:id="@+id/text_click_selected_app"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/not_selected"
                    android:textSize="14sp"
                    android:textColor="?attr/textSecondary"
                    android:gravity="end" />

            </LinearLayout>

            <!-- 启动配置（仅当单击行为为"打开指定应用"时可见） -->
            <LinearLayout
                android:id="@+id/layout_click_launch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="14dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/launch_config"
                    android:textSize="15sp"
                    android:textColor="?attr/textPrimary" />

                <TextView
                    android:id="@+id/text_click_launch_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="190dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/launch_config_default"
                    android:textSize="14sp"
                    android:textColor="?attr/textSecondary"
                    android:gravity="end" />

            </LinearLayout>

            <!-- 单击窗口打开开关 -->
            <LinearLayout
                android:id="@+id/layout_click_open_in_window"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="8dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="窗口打开"
                    android:textSize="14sp"
                    android:textColor="?attr/textPrimary" />

                <Switch
                    android:id="@+id/switch_click_open_in_window"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="?attr/colorPrimaryBrand"
                    android:trackTint="#BDBDBD" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/dividerLight" />

            <!-- 双击行为选择 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/double_click_action"
                android:textSize="15sp"
                android:textColor="?attr/textPrimary"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/spinner_double_click_action"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:entries="@array/action_entries"
                android:background="@drawable/spinner_background"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="8dp" />

            <!-- 双击触发时振动（行为为"无"时隐藏） -->
