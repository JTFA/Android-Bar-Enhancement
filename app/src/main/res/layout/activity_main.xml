<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/dividerColor">

    <!-- 固定标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/bgPage"
        android:elevation="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="小横条扩展"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="?attr/textPrimary"
            android:paddingHorizontal="16dp"
            android:paddingTop="46dp"
            android:paddingBottom="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/dividerColor" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

<!--        <TextView-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:text="请先授予悬浮窗权限，然后启动服务"-->
<!--            android:textSize="14sp"-->
<!--            android:textColor="?attr/textSecondary"-->
<!--            android:layout_marginBottom="24dp" />-->

        <!-- 权限与服务卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="权限与服务"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/textPrimary"
                android:layout_marginBottom="4dp" />

            <!-- 悬浮窗权限状态 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="悬浮窗权限"
                    android:textSize="15sp"
                    android:textColor="?attr/textPrimary" />

                <TextView
                    android:id="@+id/text_overlay_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="未授予"
                    android:textSize="13sp"
                    android:textColor="#F44336" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/dividerLight" />

            <!-- 启动悬浮窗服务 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="启动悬浮窗服务"
                        android:textSize="15sp"
                        android:textColor="?attr/textPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="开启后悬浮窗将在后台运行"
                        android:textSize="12sp"
                        android:textColor="?attr/textHint"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <Switch
                    android:id="@+id/switch_service"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="?attr/colorPrimaryBrand"
                    android:trackTint="?attr/trackColor" />

            </LinearLayout>

        </LinearLayout>

        <!-- 交互与样式设置卡片（含触发行为 + 样式设置 / 快捷方式编辑入口） -->
        <include layout="@layout/view_trigger_actions" />

        <!-- 启动与后台卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="启动与后台"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/textPrimary"
                android:layout_marginBottom="4dp" />

            <!-- 开机自启 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="开机自启"
                        android:textSize="15sp"
                        android:textColor="?attr/textPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="设备启动时自动运行悬浮窗"
                        android:textSize="12sp"
                        android:textColor="?attr/textHint"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <Switch
                    android:id="@+id/switch_boot_start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="?attr/colorPrimaryBrand"
                    android:trackTint="?attr/trackColor" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/dividerLight" />

            <!-- 在最近任务中隐藏 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="在最近任务中隐藏"
                        android:textSize="15sp"
                        android:textColor="?attr/textPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="不在最近任务列表中显示"
                        android:textSize="12sp"
                        android:textColor="?attr/textHint"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <Switch
                    android:id="@+id/switch_exclude_recents"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="?attr/colorPrimaryBrand"
                    android:trackTint="?attr/trackColor" />

            </LinearLayout>

        </LinearLayout>

        <!-- 提示信息 -->
<!--        <TextView-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:text="提示：启动服务后，Activity将关闭，悬浮窗将在后台运行"-->
<!--            android:textSize="12sp"-->
<!--            android:textColor="?attr/textHint"-->
<!--            android:gravity="center"-->
<!--            android:layout_gravity="center_horizontal"-->
<!--            android:layout_marginTop="8dp" />-->

    </LinearLayout>

    </ScrollView>

</LinearLayout>
