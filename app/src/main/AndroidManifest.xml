<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 获取已安装应用列表权限（用于选择要打开的第三方应用） -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- 悬浮窗权限 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 前台服务权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 通知权限（Android 13+ 必须声明，否则通知被系统拦截且设置开关置灰） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 振动权限（手势触发时短促振动反馈） -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 网络权限（AI_WINDOW_ENABLED=false 期间隐藏；恢复时取消注释并打开 AppConfig.AI_WINDOW_ENABLED） -->
<!--    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />-->
    <!-- 麦克风和相机权限（WebView 语音输入/文件上传）
         AI_WINDOW_ENABLED=false 期间隐藏；恢复时取消注释并打开 AppConfig.AI_WINDOW_ENABLED -->
<!--    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />-->
    <!-- 开机自启权限 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AI悬浮窗">

        <!-- 禁用 WebView Safe Browsing，避免页面加载被拦截导致空白 -->
        <meta-data
            android:name="android.webkit.WebView.EnableSafeBrowsing"
            android:value="false" />

        <!-- 透明启动代理，永久隐藏于最近任务中 -->
        <activity
            android:name=".SplashActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.ModernSettings">
        </activity>

        <!-- 权限管理页面 -->
        <activity
            android:name=".PermissionCheckActivity"
            android:exported="false"
            android:label="权限管理"
            android:theme="@style/Theme.ModernSettings" />

        <!-- 设置页面（可选） -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="提示条设置"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.ModernSettings" />

        <!-- 悬浮窗前台服务 -->
        <service
            android:name=".FloatWindowService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="悬浮窗显示" />
        </service>

        <!-- 简化测试服务 -->
        <service
            android:name=".SimpleFloatService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="简化测试" />
        </service>

        <!-- 透明 Activity，用于 WebView 文件选择代理 -->
        <activity
            android:name=".FileChooserActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="false"
            android:taskAffinity="" />

        <!-- 透明代理 Activity，用于接收系统返回事件（导航栏返回键 + 手势返回） -->
        <activity
            android:name=".WindowHostActivity"
            android:theme="@style/Theme.TransparentHost"
            android:exported="false"
            android:resizeableActivity="false"
            android:excludeFromRecents="true"
            android:taskAffinity="com.jtfa.barenhancement.floating"
            android:launchMode="singleTask" />

        <!-- 快捷方式编辑页面 -->
        <activity
            android:name=".ShortcutEditActivity"
            android:exported="false"
            android:label="编辑快捷方式"
            android:theme="@style/Theme.ModernSettings" />

        <activity
            android:name=".BlurWindowActivity"
            android:theme="@style/Theme.BlurNoAnim"
            android:excludeFromRecents="true"
            android:exported="false"
            android:resizeableActivity="false"
            android:taskAffinity="com.jtfa.barenhancement.floating" />

        <activity
            android:name=".OverlayWindowActivity"
            android:theme="@style/Theme.TransparentNoAnimation"
            android:excludeFromRecents="true"
            android:exported="false"
            android:resizeableActivity="false"
            android:taskAffinity="com.jtfa.barenhancement.floating"
            android:configChanges="orientation|keyboardHidden|screenSize" />

        <!-- 删除 WindowHostActivity 的声明 -->

        <!-- 开机自启 / 覆盖安装后恢复 广播接收器 -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <!-- HTC 设备快速启动 -->
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <!-- 覆盖安装完成后按上次的开关状态恢复悬浮窗服务 -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- FileProvider 用于为 WebView 上传提供可读的 content:// URI -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
